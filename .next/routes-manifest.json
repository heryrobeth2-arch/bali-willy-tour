{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "ALLOWALL"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors *;"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, PUT, DELETE, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "*"
        }
      ],
      "regex": "^(?:/(.*))(?:/)?$"
    }
  ],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/members/[id]",
      "regex": "^/api/members/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/members/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/members/[id]/transactions",
      "regex": "^/api/members/([^/]+?)/transactions(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/members/(?<nxtPid>[^/]+?)/transactions(?:/)?$"
    },
    {
      "page": "/api/rewards/[id]",
      "regex": "^/api/rewards/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/rewards/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/tour-packages/[id]",
      "regex": "^/api/tour\\-packages/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/tour\\-packages/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/vouchers/[id]/verify",
      "regex": "^/api/vouchers/([^/]+?)/verify(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/vouchers/(?<nxtPid>[^/]+?)/verify(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_global-error",
      "regex": "^/_global\\-error(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_global\\-error(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/api",
      "regex": "^/api(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api(?:/)?$"
    },
    {
      "page": "/api/auth/admin",
      "regex": "^/api/auth/admin(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/auth/admin(?:/)?$"
    },
    {
      "page": "/api/auth/member",
      "regex": "^/api/auth/member(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/auth/member(?:/)?$"
    },
    {
      "page": "/api/members",
      "regex": "^/api/members(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/members(?:/)?$"
    },
    {
      "page": "/api/rewards",
      "regex": "^/api/rewards(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/rewards(?:/)?$"
    },
    {
      "page": "/api/rewards/redeem",
      "regex": "^/api/rewards/redeem(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/rewards/redeem(?:/)?$"
    },
    {
      "page": "/api/tour-packages",
      "regex": "^/api/tour\\-packages(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/tour\\-packages(?:/)?$"
    },
    {
      "page": "/api/vouchers",
      "regex": "^/api/vouchers(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/vouchers(?:/)?$"
    },
    {
      "page": "/membership",
      "regex": "^/membership(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/membership(?:/)?$"
    },
    {
      "page": "/membership/admin",
      "regex": "^/membership/admin(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/membership/admin(?:/)?$"
    },
    {
      "page": "/membership/admin/dashboard",
      "regex": "^/membership/admin/dashboard(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/membership/admin/dashboard(?:/)?$"
    },
    {
      "page": "/membership/dashboard",
      "regex": "^/membership/dashboard(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/membership/dashboard(?:/)?$"
    },
    {
      "page": "/membership/login",
      "regex": "^/membership/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/membership/login(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments",
    "clientParamParsing": false,
    "dynamicRSCPrerender": false
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}