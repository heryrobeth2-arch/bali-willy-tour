#!/bin/bash
# Bootstrap script for FC custom runtime
# This script is called by the platform to start the application
cd /home/z/my-project || exit 1
export PORT=3000
export HOSTNAME=0.0.0.0
export NEXT_TELEMETRY_DISABLED=1
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:$PATH"

echo "=== Bali Willy Tour Bootstrap ==="

# Install dependencies if needed
if [ ! -d "node_modules" ] || [ ! -f "node_modules/.bin/next" ]; then
  echo "Installing dependencies..."
  if command -v bun &>/dev/null; then
    bun install 2>&1
  elif [ -f "package-lock.json" ]; then
    npm ci --prefer-offline 2>&1 || npm install 2>&1
  else
    npm install 2>&1
  fi
fi

# Build if needed
if [ ! -f ".next/BUILD_ID" ]; then
  echo "Building Next.js..."
  npx next build 2>&1
fi

# Start the server
echo "Starting Next.js server..."
exec node_modules/.bin/next start -p 3000 -H 0.0.0.0
